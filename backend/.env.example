# SOIS Backend — Environment variables (example)
# Owned by: Member 6 (Architecture & Research) + Member 5 (Database + API) — Phase 1 db/ph1-schema
# Copy to .env and fill in your own values. Never commit .env.

# PostgreSQL connection
DATABASE_URL="postgresql://sois:sois@localhost:5432/sois?schema=public"

# Redis (queue/cache/rate-limit)
REDIS_URL="redis://redis:6379"

# Server
PORT=3001
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"

# Auth — JWT_SECRET must be >=32 chars in production (see main.ts)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# Rate limiting (Throttler) — M6-03
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
